<mxfile type="device"><diagram name="Submission State Machine" id="submission-state-machine"><mxGraphModel grid="1" page="1" pageWidth="1280" pageHeight="760" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Submission State Machine" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#1A2B47;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1220" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="Final implementation: persisted submission status and guarded transitions" style="text;html=1;whiteSpace=wrap;align=center;fontSize=16;fontFamily=Helvetica;fontColor=#1A2B47;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1200" height="52" as="geometry" /></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#1A2B47;strokeColor=#1A2B47;fontFamily=Helvetica;fontColor=#1A2B47;" vertex="1" parent="1"><mxGeometry x="70" y="315" width="30" height="30" as="geometry" /></mxCell><mxCell id="submitted" value="Submitted" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7EFFA;strokeColor=#2E5C9A;fontSize=21;spacing=10;fontFamily=Helvetica;fontColor=#1A2B47;" vertex="1" parent="1"><mxGeometry x="190" y="275" width="230" height="110" as="geometry" /></mxCell><mxCell id="review" value="Under review" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7EFFA;strokeColor=#2E5C9A;fontSize=21;spacing=10;fontFamily=Helvetica;fontColor=#1A2B47;" vertex="1" parent="1"><mxGeometry x="550" y="275" width="230" height="110" as="geometry" /></mxCell><mxCell id="graded" value="Graded" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7EFFA;strokeColor=#2E5C9A;fontSize=21;spacing=10;fontFamily=Helvetica;fontColor=#1A2B47;" vertex="1" parent="1"><mxGeometry x="910" y="275" width="230" height="110" as="geometry" /></mxCell><mxCell id="guard" value="Access guard: only the assignment owner may review or grade. Only the submitting student and that 