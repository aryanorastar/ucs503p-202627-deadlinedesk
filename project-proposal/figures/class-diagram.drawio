<mxfile host="drawio-mcp" agent="draw.io MCP create_diagram; exported with draw.io Desktop" type="device"><diagram name="Class Diagram" id="class-diagram-p1"><mxGraphModel dx="2160" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1400" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DeadlineDesk — UML Class Diagram (Week 7 implementation)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#1A2B47;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2160" height="32" as="geometry"/></mxCell><mxCell id="sub" value="Classes and functions as they exist in code/core. Models extend django.db.models.Model (User extends AbstractUser); views, services and decorators are module-level functions, shown as «module» classifiers." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#5B6779;" vertex="1" parent="1"><mxGeometry x="0" y="44" width="2160" height="22" as="geometry"/></mxCell><mxCell id="pk_models" value="core.models (Django ORM, stored in SQLite)" style="shape=folder;tabWidth=330;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fillColor=none;strokeColor=#5B6779;fontFamily=Helvetica;fontColor=#1A2B47;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1470" height="1300" as="geometry"/></mxCell><mxCell id="pk_app" value="Application layer (code/core)" style="shape=folder;tabWidth=250;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fillColor=none;strokeColor=#5B6779;fontFamily=Helvetica;fontColor=#1A2B47;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="80" width="630" height="1300" as="geometry"/></mxCell><mxCell id="abs" value="«Dj