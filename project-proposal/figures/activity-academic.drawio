1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#44536B;strokeWidth=1.2;fontFamily=Helvetica;fontSize=14;fontColor=#44536B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="t2"><mxGeometry x="-0.3" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1532.0" y="407.0"/><mxPoint x="1532.0" y="197.0"/></Array></mxGeometry></mxCell><mxCell id="e13" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#44536B;strokeWidth=1.2;fontFamily=Helvetica;fontSize=14;fontColor=#44536B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="s4"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1444.0" y="477.0"/><mxPoint x="1645.6" y="477.0"/></Array></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#44536B;strokeWidth=1.2;fontFamily=Helvetica;fontSize=14;fontColor=#44536B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="u3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1763.2" y="407.0"/></Array></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#44536B;strokeWidth=1.2;fontFamily=Helvetica;fontSize=14;fontColor=#44536B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u3" target="en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;Late-policy rules&lt;/b&gt; (services.evaluate_lateness)&lt;br&gt;• At or before due time → on time&lt;br&gt;• Late + reject → rejected&lt;br&gt;• Late + penalty → accepted, penalty %&lt;br&gt;• Late + grace → accepted until due + grace minutes, then rejected" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6779;fontFamily=Helvetica;fontColor=#1A2B47;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="415.6" y="122" width="300" height="140" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Similarity stub.&lt;/b&gt; Jaccard overlap of words (3+ characters) with earlier submissions to the same assignment. Files are read as UTF-8 with undecodable bytes ignored, so the score is only meaningful for text. Not plagiarism detection." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6779;fontFamily=Helvetica;fontColor=#1A2B47;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="730.6" y="122" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Audit and limits.&lt;/b&gt; Publishing, submitting, starting review and grading each write an AuditLog row. One submission per student per assignment." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6779;fontFamily=Helvetica;fontColor=#1A2B47;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1045.6" y="122" width="200" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
